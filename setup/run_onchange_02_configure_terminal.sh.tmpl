#!/usr/bin/env bash
set -euo pipefail

{{ if contains "microsoft" (lower .chezmoi.kernel.osrelease) }}
    # Copy the wsl.conf from Chezmoi to the /etc directory
    sudo cp {{ joinPath .chezmoi.sourceDir "wsl.conf" }} /etc

    # Resolve the Windows user and configuration directory for WezTerm
    WIN_USER=$(cmd.exe /c 'echo %USERNAME%' 2>/dev/null | tr -d '\r\n')
    WEZTERM_CONFIG_DIR="/mnt/c/Users/${WIN_USER}/.config/wezterm"

    echo "Copying WezTerm config to Windows..."
    mkdir -p "$WEZTERM_CONFIG_DIR"
    cp ~/.config/wezterm/wezterm.lua "$WEZTERM_CONFIG_DIR/wezterm.lua"

    nohup powershell.exe -WindowStyle Hidden -Command "Start-Sleep -Seconds 3; wsl --shutdown" > /dev/null 2>&1 &
{{ end }}